#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Z    &kp U  &kp I      &kp O    &kp P      &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &trans     &trans
&kp LS(Y)  &kp Y  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp MINUS  &trans
                         &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&kp TAB    &kp N1     &kp N2  &kp N3    &kp N4  &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&kp TAB    &trans     &trans  &trans    &trans  &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT  &kp LSHFT  &trans  &trans    &trans  &trans       &trans    &trans    &trans    &trans     &trans  &trans
                              &kp LALT  &trans  &kp SPACE    &kp RET   &trans    &kp RALT
            >;
        };

        layer_2 {
            bindings = <
&kp TAB    &kp LS(EXCL)  &kp LS(DQT)  &kp LS(DLLR)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(AMPS)  &kp LBRC  &kp LBKT       &kp RBKT  &kp RBRC   &kp BSPC
&kp LCTRL  &kp AT        &kp PIPE     &kp LT        &kp LS(GT)    &kp POUND        &kp APOS      &trans    &kp LS(EQUAL)  &kp PLUS  &kp TILDE  &trans
&kp LSHFT  &trans        &trans       &trans        &trans        &trans           &kp LS(AMPS)  &kp BSLH  &kp BSLH       &trans    &trans     &trans
                                      &kp LGUI      &trans        &kp SPACE        &kp RET       &trans    &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

